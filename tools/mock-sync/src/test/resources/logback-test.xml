<configuration>
	<!-- Overrides the logback.xml inside the keymanager test dependency. -->
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} %-5level %logger{0} - %msg%n</pattern>
		</encoder>
	</appender>
	<logger name="io.mosip.mocksync" level="INFO"/>
	<root level="WARN">
		<appender-ref ref="STDOUT"/>
	</root>
</configuration>
