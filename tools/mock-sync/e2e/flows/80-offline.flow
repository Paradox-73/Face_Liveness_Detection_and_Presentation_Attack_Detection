# Offline: every server call of the client fails (network off; MockSync keeps running for other clients). The
# officer logs in with password and face liveness against the local database, registers a resident with packet
# authentication, and the supervisor approves at end of day; liveness behaves exactly as online. The network
# comes back at the end and the packets are uploaded.
label offline: network cut; login, registration and EOD run locally
network off
set USER ${OFFICER}
set PASSWORD ${OFFICER_PASSWORD}
set OPERATOR ${OFFICER_FACE}
include lib/face-login.flow
set RESIDENT_NAME Dara Offline
include lib/registration-start.flow
source s2-main
click #individualBiometricsScanBtn
expect Good, face captured successfully 60
sleep 3000
include lib/registration-finish.flow
set USER ${SUPERVISOR}
set PASSWORD ${SUPERVISOR_PASSWORD}
set OPERATOR ${SUPERVISOR_FACE}
include lib/face-login.flow
set ATTACK a-s3-screen-replay
include lib/eod-approve.flow
label offline: network back, upload
network on
sleep 5000
include lib/upload.flow
