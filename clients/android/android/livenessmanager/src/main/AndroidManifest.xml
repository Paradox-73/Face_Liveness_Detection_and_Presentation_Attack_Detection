<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The built-in face camera (an SBI L0 device inside the client). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- supportsRtl: without it Android lays out every native view left-to-right, so the Arabic capture screen
         would not mirror. ARC declares no value; its Flutter screens handle direction themselves. -->
    <application android:supportsRtl="true">
        <!-- "locked": keeps the orientation the tablet or phone had when the screen opened, so the camera's
             target rotation stays valid for the whole session and a landscape tablet is not letterboxed. -->
        <activity
            android:name=".ui.LivenessCaptureActivity"
            android:exported="false"
            android:screenOrientation="locked"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Liveness" />

        <!-- In-app provisioning of the built-in face device key (release and debug builds): started over adb by
             scripts/android-liveness-device-cert.sh in its CSR mode. Only callers holding DUMP may start it (the adb shell
             does; ordinary apps cannot get it). It shows nothing and closes when the step is done. -->
        <activity
            android:name=".device.DeviceProvisioningActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Tells the device key where the provisioning files are exchanged (app-specific external files). -->
        <provider
            android:name=".device.DeviceProvisioningInitializer"
            android:authorities="${applicationId}.liveness-device-provisioning"
            android:exported="false" />
    </application>
</manifest>
