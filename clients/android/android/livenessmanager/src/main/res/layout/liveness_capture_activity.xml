<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/liveness_background">

    <!-- Camera preview, mirrored like a selfie by PreviewView for the front camera. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/liveness_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/liveness_ui_preview"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <!-- Replay frames (debug builds), mirrored the same way as the camera preview. -->
    <ImageView
        android:id="@+id/liveness_replay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/liveness_ui_preview"
        android:scaleType="centerCrop"
        android:scaleX="-1"
        android:visibility="gone" />

    <io.mosip.registration.livenessmanager.ui.OvalGuideView
        android:id="@+id/liveness_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/liveness_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/liveness_ui_title"
            android:textColor="@color/liveness_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/liveness_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/liveness_badge_background"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/liveness_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Diagnostic mode only (diagnostic.enable=Y): execution provider, frame times of the last attempt and
             the anonymised metrics of this app run. No image, score of a capture or user data. -->
        <TextView
            android:id="@+id/liveness_diagnostics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/liveness_badge_background"
            android:fontFamily="monospace"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textColor="@color/liveness_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/liveness_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/liveness_panel_background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Prompt banner in the status colours shared with the desktop client: background, start border,
             icon circle and prompt colour follow the state's severity (StatusPalette). -->
        <LinearLayout
            android:id="@+id/liveness_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/liveness_status_neutral"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/liveness_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/liveness_icon_circle"
                    android:backgroundTint="@color/liveness_status_neutral_accent"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_liveness_progress"
                    android:tint="@color/liveness_text" />

                <TextView
                    android:id="@+id/liveness_prompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/liveness_status_checking"
                    android:textColor="@color/liveness_status_neutral_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/liveness_guidance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/liveness_status_guidance"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/liveness_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/liveness_text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/liveness_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:importantForAccessibility="no"
            android:max="100"
            android:progressTint="@color/liveness_accent" />

        <LinearLayout
            android:id="@+id/liveness_attempts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/liveness_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/liveness_settings"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/liveness_ui_settings"
                android:textColor="@color/liveness_accent"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/liveness_cancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/liveness_ui_cancel"
                android:textColor="@color/liveness_text"
                app:strokeColor="@color/liveness_text_secondary"
                app:strokeWidth="2dp" />

            <!-- Resident workflows with on_max_failure=SUPERVISOR_OVERRIDE, after the last attempt only. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/liveness_override"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/liveness_ui_override"
                android:textColor="@color/liveness_text"
                android:visibility="gone"
                app:strokeColor="@color/liveness_text_secondary"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/liveness_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/liveness_ui_retry"
                android:textColor="@color/liveness_text"
                android:visibility="gone"
                app:backgroundTint="@color/liveness_primary" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
