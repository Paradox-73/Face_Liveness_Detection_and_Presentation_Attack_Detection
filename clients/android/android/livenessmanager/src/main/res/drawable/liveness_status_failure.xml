<?xml version="1.0" encoding="utf-8"?>
<!-- Prompt banner, failure state: light background with a 6 dp border on the start side, as on the desktop client
     (liveness-panel.css .liveness-banner). Colours: values/colors.xml, status palette. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/liveness_status_failure_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:start="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/liveness_status_failure_banner" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
