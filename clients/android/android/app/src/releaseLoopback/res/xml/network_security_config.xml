<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds whose server URL is plain HTTP on this device itself (arcReleaseServerBaseUrl
     http://127.0.0.1:<port> or http://localhost:<port>, a MockSync reached through
     `adb reverse tcp:8080 tcp:8080` for a demo). app/build.gradle adds this folder to the release
     resources only in that case; it replaces clientmanager's network_security_config.xml.
     Cleartext is allowed to the loopback address only, which never leaves the device; every other
     host stays HTTPS-only, as in clientmanager's file. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">jsonplaceholder.typicode.com</domain>
        <domain includeSubdomains="true">dev.mosip.net</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
