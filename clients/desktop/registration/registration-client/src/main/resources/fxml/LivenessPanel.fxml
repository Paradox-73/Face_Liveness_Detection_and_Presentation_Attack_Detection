<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.shape.SVGPath?>

<!-- Face liveness panel: live preview with oval guide, prompt banner, progress, attempts and actions.
     Loaded by io.mosip.registration.controller.liveness.LivenessPanel (fx:root); texts are set in code. -->
<fx:root type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
		 styleClass="liveness-panel" spacing="12.0" prefWidth="520.0" maxWidth="520.0">
	<padding>
		<Insets top="16.0" right="20.0" bottom="16.0" left="20.0" />
	</padding>
	<children>
		<HBox styleClass="liveness-header" alignment="CENTER_LEFT" spacing="10.0">
			<children>
				<Label fx:id="titleLabel" styleClass="liveness-title" />
			</children>
		</HBox>
		<StackPane fx:id="previewPane" styleClass="liveness-preview" prefWidth="480.0" prefHeight="360.0"
				   minWidth="480.0" minHeight="360.0" maxWidth="480.0" maxHeight="360.0">
			<children>
				<ImageView fx:id="previewImage" fitWidth="480.0" fitHeight="360.0" preserveRatio="true" smooth="true" />
				<Ellipse fx:id="ovalGuide" styleClass="liveness-oval" radiusX="105.0" radiusY="140.0" />
				<Label fx:id="offlineBadge" styleClass="liveness-offline-badge" visible="false" managed="false"
					   StackPane.alignment="TOP_LEFT">
					<StackPane.margin>
						<Insets top="10.0" left="10.0" />
					</StackPane.margin>
				</Label>
			</children>
		</StackPane>
		<HBox fx:id="promptBanner" styleClass="liveness-banner" alignment="CENTER_LEFT" spacing="14.0">
			<children>
				<StackPane fx:id="iconBox" styleClass="liveness-icon-box" minWidth="56.0" minHeight="56.0" maxWidth="56.0" maxHeight="56.0"
						   prefWidth="56.0" prefHeight="56.0">
					<children>
						<SVGPath fx:id="promptIcon" styleClass="liveness-icon" scaleX="1.8" scaleY="1.8" />
					</children>
				</StackPane>
				<VBox spacing="4.0" minWidth="0.0" prefWidth="360.0" HBox.hgrow="ALWAYS">
					<children>
						<Label fx:id="promptLabel" styleClass="liveness-prompt" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" />
						<VBox fx:id="guidanceBox" styleClass="liveness-guidance" spacing="2.0" />
					</children>
				</VBox>
				<ProgressIndicator fx:id="busyIndicator" styleClass="liveness-busy" prefWidth="32.0" prefHeight="32.0"
								   visible="false" managed="false" />
			</children>
		</HBox>
		<HBox styleClass="liveness-progress-row" alignment="CENTER_LEFT" spacing="12.0">
			<children>
				<ProgressBar fx:id="progressBar" styleClass="liveness-progress" progress="0.0" maxWidth="Infinity"
							 HBox.hgrow="ALWAYS" />
				<Label fx:id="stepLabel" styleClass="liveness-counter" />
				<Label fx:id="attemptLabel" styleClass="liveness-counter" />
			</children>
		</HBox>
		<Label fx:id="diagnosticLabel" styleClass="liveness-diagnostic" wrapText="true" visible="false"
			   managed="false" />
		<HBox styleClass="liveness-actions" alignment="CENTER_RIGHT" spacing="12.0">
			<children>
				<Button fx:id="overrideButton" styleClass="liveness-secondary-button" visible="false" managed="false"
						mnemonicParsing="false" onAction="#onOverride" />
				<Region HBox.hgrow="ALWAYS" />
				<Button fx:id="cancelButton" styleClass="liveness-secondary-button" cancelButton="true"
						mnemonicParsing="false" onAction="#onCancel" />
				<Button fx:id="retryButton" styleClass="liveness-primary-button" defaultButton="true"
						visible="false" managed="false" mnemonicParsing="false" onAction="#onRetry" />
			</children>
		</HBox>
	</children>
</fx:root>
